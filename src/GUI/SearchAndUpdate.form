<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.SearchAndUpdate">
  <grid id="27dc6" binding="SearchAndUpdatePanel" layout-manager="GridLayoutManager" row-count="5" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="735" height="388"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="5f661" class="javax.swing.JLabel" binding="SearchAndUpdateMessage">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="6" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="20" style="1"/>
          <text value="Search and Update Student Details "/>
        </properties>
      </component>
      <scrollpane id="d0780" binding="ScrollPane">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="6" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="65fcc" class="javax.swing.JTable" binding="Table">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="96f5a" class="javax.swing.JLabel" binding="PressToSortMessage">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="6" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="18" style="1"/>
          <text value="Press on the Category to Sort "/>
        </properties>
      </component>
      <component id="e4cb9" class="javax.swing.JTextField" binding="SearchField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value=""/>
        </properties>
      </component>
      <component id="5d31e" class="javax.swing.JLabel" binding="SearchMessage">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Search :"/>
        </properties>
      </component>
      <component id="9ca28" class="javax.swing.JRadioButton" binding="SearchByNameRadioButton">
        <constraints>
          <grid row="2" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Search By Name"/>
        </properties>
      </component>
      <component id="a1f3c" class="javax.swing.JButton" binding="SearchButton">
        <constraints>
          <grid row="2" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Search"/>
        </properties>
      </component>
      <component id="878ad" class="javax.swing.JRadioButton" binding="SearchByIDRadio">
        <constraints>
          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Search By ID"/>
        </properties>
      </component>
      <component id="31891" class="javax.swing.JButton" binding="BackButton">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Back To Main Menu"/>
        </properties>
      </component>
      <component id="ab1b7" class="javax.swing.JButton" binding="exitButton" default-binding="true">
        <constraints>
          <grid row="4" column="3" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Exit"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
