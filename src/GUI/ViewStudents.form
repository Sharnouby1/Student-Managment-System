<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.ViewStudents">
  <grid id="27dc6" binding="ViewStudentsPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="5b691" class="javax.swing.JLabel" binding="ViewStudentsMessage">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="20" style="1"/>
          <text value="View Students"/>
        </properties>
      </component>
      <scrollpane id="a3138" binding="ScrollPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="529a1" class="javax.swing.JTable" binding="Table">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="dd49c" class="javax.swing.JLabel" binding="PressToSortMessage">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="18" style="1"/>
          <text value="Press on the Category to Sort"/>
        </properties>
      </component>
      <component id="5dd7c" class="javax.swing.JButton" binding="BackButton">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Back to Main Menu"/>
        </properties>
      </component>
      <component id="fd310" class="javax.swing.JButton" binding="exitButton">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Exit"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
