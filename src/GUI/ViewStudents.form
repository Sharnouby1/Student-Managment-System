<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.ViewStudents">
  <grid id="27dc6" binding="ViewStudentsPanel" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="d7b8b" class="javax.swing.JLabel" binding="ViewStudentsMessage">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="View Students"/>
        </properties>
      </component>
      <scrollpane id="320c5" binding="ScrollPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d11f1" class="javax.swing.JTable" binding="Table" default-binding="true">
            <constraints/>
            <properties>
              <autoCreateRowSorter value="false"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="eb489" class="javax.swing.JButton" binding="SaveButton">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Save"/>
        </properties>
      </component>
      <component id="fcc6" class="javax.swing.JButton" binding="exitButton" default-binding="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Exit"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
