<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.AddStudent">
  <grid id="27dc6" binding="AddStudentPanel" layout-manager="GridLayoutManager" row-count="8" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="7e956" class="javax.swing.JLabel" binding="StudentID">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="Student ID:"/>
        </properties>
      </component>
      <component id="66d3a" class="javax.swing.JLabel" binding="StudentName">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="Full Name:"/>
        </properties>
      </component>
      <component id="46f16" class="javax.swing.JLabel" binding="StudentAge">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="Age:"/>
        </properties>
      </component>
      <component id="913d" class="javax.swing.JLabel" binding="StudentGender">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="Gender:"/>
        </properties>
      </component>
      <component id="a97ce" class="javax.swing.JLabel" binding="StudentDepartment">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="Department:"/>
        </properties>
      </component>
      <component id="57d84" class="javax.swing.JLabel" binding="StudentGPA">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="105" height="17"/>
          </grid>
        </constraints>
        <properties>
          <text value="GPA:"/>
        </properties>
      </component>
      <component id="66eb2" class="javax.swing.JLabel" binding="Title">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="5" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="24"/>
          <text value="Please Enter Student Details"/>
        </properties>
      </component>
      <component id="e3092" class="javax.swing.JTextField" binding="IDText">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="72335" class="javax.swing.JTextField" binding="NameText">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="9897a" class="javax.swing.JTextField" binding="AgeText">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="3294b" class="javax.swing.JComboBox" binding="GenderCombo">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <editable value="false"/>
          <enabled value="true"/>
          <model>
            <item value="Male"/>
            <item value="Female"/>
          </model>
        </properties>
      </component>
      <component id="b9667" class="javax.swing.JComboBox" binding="DepartmentCombo">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="Computer and Communication"/>
            <item value="Mechatronics"/>
            <item value="Electro Mechanical"/>
            <item value="Biomedical"/>
          </model>
        </properties>
      </component>
      <component id="fb787" class="javax.swing.JTextField" binding="GPAText">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="52d08" class="javax.swing.JButton" binding="SaveButton">
        <constraints>
          <grid row="7" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Save"/>
        </properties>
      </component>
      <component id="3f0dc" class="javax.swing.JButton" binding="CancelButton">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cancel"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
